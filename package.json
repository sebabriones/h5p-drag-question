{
  "name": "h5p-drag-question-cfrd",
  "version": "1.0.0",
  "description": "Drag and drop with optional shuffle of initial positions (CFRD).",
  "main": "h5p-drag-question-cfrd.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV='development' webpack",
    "build": "cross-env NODE_ENV='production' webpack",
    "sync:lumi:player": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\sync-drag-question-player-lumi.ps1",
    "sync:lumi:editor": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\sync-drag-question-editor-lumi.ps1",
    "sync:lumi:all": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\sync-lumi.ps1",
    "deploy:lumi": "npm run build && npm run sync:lumi:player",
    "deploy:lumi:editor": "npm run sync:lumi:editor",
    "watch": "webpack --watch"
  },
  "keywords": [],
  "author": "CFRD",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.18.6",
    "@babel/plugin-transform-object-assign": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "babel-loader": "^8.2.5",
    "cross-env": "^7.0.3",
    "h5p-lib-controls": "^0.0.15",
    "webpack": "^5.94.0",
    "webpack-cli": "^4.10.0"
  }
}
